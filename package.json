{
  "name": "claudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:loading": "tsx --test src/hooks/usePlayer.test.ts src/app/lib/loading-performance.test.tsx src/app/lib/song-playback-route.test.ts src/app/lib/ncm-playback.test.ts src/app/lib/ncm-playback-netlify.test.ts",
    "test:ncm-auth": "tsx --test src/app/lib/ncm-auth.test.ts",
    "test:ncm-playlist": "tsx --test src/app/lib/ncm-playlist.test.ts",
    "test:playlist-import": "tsx --test src/app/lib/playlist-import.test.ts",
    "dev": "concurrently --names \"NCM,NEXT\" --prefix-colors \"cyan,green\" \"node scripts/start-music-api.js\" \"next dev -p 3000\"",
    "build": "next build && node scripts/check-ncm-trace.mjs",
    "build:netlify": "prisma generate && next build --webpack && node scripts/check-ncm-trace.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:music-history": "tsx --test src/app/lib/music-history.test.ts",
    "test:concert-stage": "tsx --test src/app/lib/concert-stage-motion.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.22.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "next": "16.2.6",
    "ogl": "^1.0.11",
    "opencc-js": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
